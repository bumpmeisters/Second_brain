# Local app state
.obsidian/
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/
.trash/

# Codex/plugin runtime scratch
.agents/
.git-publish-temp*/
.tmp/
.env/
plugins/
plugins/*/.env
plugins/*/.mcp.json
plugins/*/node_modules/

# Secrets and local environment
.env
.env.*
!.env.example

# OS/editor noise
Thumbs.db
Desktop.ini
~$*
*.tmp
*.bak

# Generated caches
__pycache__/
.pytest_cache/
node_modules/

# Local binary source libraries (available to the vault, never published)
/raw/assets/*
!/raw/assets/README.md
/research/assets/*
!/research/assets/README.md

# Local source inbox payloads and quarantine
/inbox/raw/*
!/inbox/raw/.gitkeep
/inbox/research/*
!/inbox/research/.gitkeep
/inbox/_quarantine/*
!/inbox/_quarantine/.gitkeep

# Private derived newsletter state (mail bodies remain in Gmail)
wiki/_outputs/newsletter-intelligence/
wiki/_outputs/youtube-intelligence/
.shopify-cli-appdata/

# Local source-derived artifacts and ledgers (publication boundary)
wiki/_extractions/
wiki/_outputs/source-conversions/
wiki/_outputs/source-curation/

# Local semantic-ingest decisions and source-selection ledgers
wiki/_outputs/semantic-ingest/
wiki/_outputs/semantic-ingest-*-intake-ledger.csv
wiki/_outputs/source-intake/

# Local source coverage inventory (contains ignored source filenames)
wiki/_outputs/source-coverage/source-inventory.csv

# Local recovery manifest detail (contains private source and project filenames)
wiki/_outputs/recovery-manifest/private/

# Local Firecrawl research cache
.firecrawl/
