  "forbidden_payload_fields": [
    "payload",
    "specialized_packet",
    "canonical_artifacts",
    "content",
    "body"
  ],
  "sha256_pattern": "^[A-F0-9]{64}$",
  "legacy_unversioned_literal": "legacy-unversioned",
  "not_applicable_literal": "not-applicable",
  "reserved_upstream_decisions": [
    "change-source-evidence",
    "change-claim-status",
    "change-market-definition",
    "change-audience-definition",
    "change-segmentation",
    "change-positioning",
    "change-brand-core",
    "change-gtm-strategy",
    "change-campaign-strategy",
    "approve-publication",
    "interpret-performance",
    "promote-method"
  ],
  "readiness_rules": {
    "blocking_evidence_states": [
      "needs-verification",
      "contradicted",
      "missing"
    ],
    "hypothesis_evidence_states": [
      "inferred",
      "hypothesis"
    ],
    "blocking_freshness_states": [
      "unknown",
      "stale"
    ],
    "blocking_approval_states": [
      "pending",
      "held",
      "rejected"
    ]
  },
  "rules": [
    "all references resolve within the vault and match their SHA-256 fingerprints",
    "authority_ref scope contains the allowed decision and matches its authority record",
    "canonical artifact ownership remains with the source project",
    "producer and consumer must have active current authority and routing in the registry",
    "allowed and prohibited decisions do not overlap and reserved upstream decisions are prohibited",
    "declared readiness equals the conservative roll-up of artifact evidence, freshness, and approval",
    "draft contracts cannot be asserted as active specialized contracts",
    "state-changing handoffs require a resolvable rollback contract; non-mutating handoffs use not-applicable",
    "references are pointers only; copied payload fields are forbidden"
  ]
}
