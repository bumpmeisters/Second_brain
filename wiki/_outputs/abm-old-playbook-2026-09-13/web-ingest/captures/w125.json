nert-toggle-target\">\n        \n      </span>\n  \n\n<!---->\n      \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n\n    <div data-responsive-handler=\"me-menu-inert-responsive-handler\" data-test-id=\"me-menu-responsive-handler\"></div>\n\n    \n    <div class=\"dropdown__container me-menu me-menu--signed-out\" data-test-id=\"me-menu\">\n      <button class=\"dropdown__trigger me-menu__dropdown-trigger plain-button\" data-test-selector=\"dropdown-trigger\" aria-expanded=\"false\" aria-controls=\"me-menu-dropdown\" aria-label=\"Navigation Menu\">\n        \n<!---->        <span class=\"me-menu__trigger-icon desktop-excluded tablet-excluded\" data-test-id=\"mobile-trigger-icon\">\n          <span class=\"visually-hidden\">Dropdown menu, expand to explore help for other LinkedIn products</span>\n          <li-icon size=\"large\" type=\"hamburger-icon\"></li-icon>\n        </span>\n      \n      </button>\n      <div class=\"dropdown__menu me-menu__dropdown-menu\" data-test-selector=\"dropdown-menu\" aria-hidden=\"true\" tabindex=\"-1\" id=\"me-menu-dropdown\" role=\"dialog\" aria-label=\"LinkedIn products menu\" aria-modal=\"true\" autofocus=\"true\">\n        \n        <button id=\"me-menu-inert-toggle-close\" class=\"me-menu__close dropdown__close plain-button desktop-excluded tablet-excluded\" data-test-id=\"me-menu-close\" type=\"button\">\n          <li-icon size=\"large\" type=\"cancel-icon\"></li-icon>\n          <span class=\"visually-hidden\">Close menu</span>\n        </button>\n<!---->        <section class=\"me-menu__action-links\" data-test-id=\"me-menu-action-links\">\n<!---->\n<!---->\n            <div class=\"me-menu__action-link-group desktop-excluded tablet-excluded\" data-test-id=\"me-menu-available-help-centers\">\n              <h4 id=\"help-center-list-title\" class=\"t-bold t-16 me-menu__section-header\">\n                Get help with:\n              </h4>\n              <ul aria-labelledby=\"help-center-list-title\">\n         